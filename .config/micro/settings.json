{
    "autoindent": true,
    "autosu": false,
    "backup": false,
    "backupdir": "",
    "basename": false,
    "clipboard": "external",
    "colorscheme": "monokai",
    "cursorline": true,
    "cursorstyle": "block",
    "detectindent": true,
    "diffgutter": false,
    "dividerchar": "│",
    "eofnewline": true,
    "fastdirty": true,
    "fileformat": "unix",
    "fillcheck": true,
    "ftoptions": "",
    "globstar": true,
    "hlsearch": true,
    "ignorecase": true,
    "incsearch": true,
    "indentchar": " ",
    "infoautocmd": true,
    "keymap": "default",
    "linter": true,
    "matchbrace": true,
    "mouse": true,
    "nocursorline": false,
    "nornu": false,
    "numbers": true,
    "pluginchannels": ["https://raw.githubusercontent.com/micro-editor/plugin-channel/master/channel.json"],
    "pluginrepos": [],
    "quithack": false,
    "rmtrailingws": true,
    "ruler": true,
    "scrollmargin": 3,
    "scrollspeed": 3,
    "shell": true,
    "smartpaste": true,
    "softwrap": false,
    "splitright": true,
    "splitsame": true,
    "statusformatl": "  Micro  [ #{buffer:modified} ] [ #{buffer:filetype} ] [ %opt{autoindent} ] [ %opt{expandtab} ] [ %opt{tabsize} ]",
    "statusformatr": "%{cursorline} / %{cursorcol}  ",
    "suffixes": [],
    "syntax": true,
    "tabmovement": true,
    "tabsize": 2,
    "tabstospaces": true,
    "termtruecolor": true,
    "useprimary": true,
    "wordwrap": false,
    "xterm": false
}